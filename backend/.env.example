# ===================================================================
# CloudTask Backend Environment Variables (.env)
# Copy this file to .env or export these variables in your shell / IDE
# ===================================================================

DB_HOST=localhost
DB_PORT=3306
DB_NAME=cloudtask_db
DB_USERNAME=root
DB_PASSWORD=your_mysql_password

# JWT Signing Secret (must be at least 256 bits / 32 characters)
JWT_SECRET=CloudTaskSecretKeyForJWTSigningAndAuthMustBeAtLeast256BitsLong!
JWT_EXPIRATION_MS=604800000
